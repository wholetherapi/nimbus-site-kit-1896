{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/nimbus/member.schema.json",
  "title": "Nimbus Interaction Lab member record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "member_id",
    "display_name",
    "role",
    "visibility",
    "affiliations",
    "previous_institutions",
    "topics",
    "positions",
    "works",
    "contact"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "member_id": {"type": "string", "pattern": "^NLAB-[0-9]{4}$"},
    "display_name": {"type": "string", "minLength": 1},
    "role": {"enum": ["phd-candidate", "postdoc", "research-scientist", "faculty", "visiting"]},
    "visibility": {"const": "public"},
    "affiliations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "unit"],
        "properties": {"name": {"type": "string", "minLength": 1}, "unit": {"type": "string", "minLength": 1}}
      }
    },
    "previous_institutions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "topics": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "positions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "organization", "start", "end", "advisor"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "organization": {"type": "string", "minLength": 1},
          "start": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
          "end": {"type": "string", "pattern": "^([0-9]{4}-[0-9]{2}|present)$"},
          "advisor": {"type": ["string", "null"]}
        }
      }
    },
    "works": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "venue", "year", "authorship"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "venue": {"type": "string", "minLength": 1},
          "year": {"type": "integer"},
          "authorship": {"enum": ["first-author", "co-author", "second-author", "senior-author"]}
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email", "handles"],
      "properties": {
        "email": {"type": "string", "pattern": "^[^@]+@[^@]+$"},
        "handles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["github", "orcid"],
          "properties": {
            "github": {"type": "string", "minLength": 1},
            "orcid": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"}
          }
        }
      }
    }
  }
}
